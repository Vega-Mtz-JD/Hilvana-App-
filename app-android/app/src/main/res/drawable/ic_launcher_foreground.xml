<?xml version="1.0" encoding="utf-8"?>
<!--
  Logo de Hilvana: una H trazada con un hilo (hilvanar = unir con hilo).
  - Dos trazos de hilo blanco que se curvan arriba y abajo.
  - Puntadas ámbar en el centro (la barra de la H).
  - El hilo termina en una aguja.
  Todo dentro de la zona segura del ícono adaptable (círculo de 66 dp al centro).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Hilo izquierdo, con su curva arriba -->
    <path
        android:pathData="M37,80 L37,38 Q37,30 45,30"
        android:strokeWidth="7"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Hilo derecho, que baja y se curva hacia la aguja -->
    <path
        android:pathData="M71,28 L71,70 Q71,78 79,78"
        android:strokeWidth="7"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Puntadas (la barra de la H) -->
    <path
        android:pathData="M44.5,54 L48.5,54 M53,54 L57,54 M61.5,54 L65.5,54"
        android:strokeWidth="5.5"
        android:strokeColor="#FFF59E0B"
        android:strokeLineCap="round" />

    <!-- Aguja -->
    <path
        android:pathData="M77.5,79.5 L87,70"
        android:strokeWidth="4"
        android:strokeColor="#FFE6FFFB"
        android:strokeLineCap="round" />

    <!-- Ojo de la aguja -->
    <path
        android:fillColor="#FF0F766E"
        android:pathData="M84.2,72.8 m-1.3,0 a1.3,1.3 0 1,0 2.6,0 a1.3,1.3 0 1,0 -2.6,0" />
</vector>
