<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Burbuja flotante: superponer sobre otras apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Recordatorios exactos -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Notificaciones (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Servicio en primer plano para la burbuja -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Reiniciar la burbuja al encender el teléfono -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Mantener la CPU activa para alarmas (WorkManager) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Voz a texto -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Adjuntar fotos (fases posteriores) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Vibración para notificaciones -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".HilvanaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hilvana">

        <!-- Actividad principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Hilvana">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Recibir texto compartido desde otras apps -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Servicio de la burbuja flotante -->
        <service
            android:name=".service.BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Burbuja flotante para captura rápida de notas desde cualquier app" />
        </service>

        <!-- BroadcastReceiver: reiniciar burbuja al encender el teléfono -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- BroadcastReceiver: disparar alarmas de recordatorios -->
        <receiver
            android:name=".service.AlarmReceiver"
            android:exported="false" />

        <!-- Quick Settings Tile -->
        <service
            android:name=".service.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_capture"
            android:label="@string/tile_capture"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
